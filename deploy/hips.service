[Unit]
Description=HIPS - Hikarinagi Image Process Service
Documentation=https://github.com/hikarinagi/hips
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hips
EnvironmentFile=/etc/hips.env
WorkingDirectory=/var/cache/hips
Restart=on-failure
RestartSec=5s

# Run as unprivileged user
User=nobody
Group=nogroup

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Allow read-write access to cache directory
ReadWritePaths=/var/cache/hips

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Memory limit (adjust based on your server)
# MemoryMax=4G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hips

[Install]
WantedBy=multi-user.target

