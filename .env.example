# ---- Required: Cloudflare R2 (S3-compatible) ----
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# ---- Server ----
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# ---- Third-party image providers (whitelist) ----
# Single source of truth lives in packages/config/src/media.ts.
# Set this to the value of HIKARI_THIRD_PARTY_PROVIDERS_JSON.
# THIRD_PARTY_PROVIDERS_JSON=[{"name":"bangumi","allowed_hosts":["lain.bgm.tv"]},{"name":"shionlib","allowed_hosts":["t.shionlib.com"]},{"name":"vndb","allowed_hosts":["t.vndb.org"]}]

# ---- Concurrency / resource limits ----
# WORKERS=               # image worker pool size (default: CPU cores)
# VIPS_CONCURRENCY=1     # libvips threads per operation
# MAX_QUEUE=             # admission queue depth (default: WORKERS * 20), 503 beyond this
# MAX_SRC_MEGAPIXELS=50  # decompression-bomb guard (source pixel cap)
# MAX_SRC_MB=30          # max source bytes for remote fetch
# DOWNLOAD_TIMEOUT_SECS=10

# ---- In-process result cache (CDN remains the primary cache) ----
# RESULT_CACHE_MB=256    # bounded, byte-weighted; also coalesces identical concurrent requests. 0 disables.
# RESULT_CACHE_TTL_SECS=60

# ---- On-disk source cache (caches fetched originals; immutable keys, no staleness) ----
# SOURCE_CACHE_DIR=      # point at a writable dir to enable; the container mounts a volume at /var/cache/hips
# SOURCE_CACHE_GB=12     # disk size cap; least-recently-accessed evicted first. unset dir or 0 disables.

# ---- Face detection (gravity=face); the image bakes the model in ----
# FACE_MODEL=/usr/local/share/hips/face.onnx  # empty or missing file falls back to a top-anchored crop
# FACE_INFER_SIZE=320    # longest side fed to the detector
# FACE_THRESHOLD=0.28    # model best-F1 point is 0.278
# FACE_SESSIONS=         # concurrent detections (default: WORKERS/2, clamped to WORKERS)
# FACE_THREADS=1         # ONNX intra-op threads; size FACE_SESSIONS instead of raising this
# FACE_CACHE_ENTRIES=50000
# FACE_CACHE_TTL_SECS=86400

# ---- Encoder effort ----
# WEBP_EFFORT=4          # 0..6
# AVIF_EFFORT=4          # 0..9

# ---- Remote fetch SSRF ----
# ALLOW_PRIVATE_REMOTE=false  # keep false in production

# ---- Memory (glib/glibc fragmentation) ----
MALLOC_ARENA_MAX=2
